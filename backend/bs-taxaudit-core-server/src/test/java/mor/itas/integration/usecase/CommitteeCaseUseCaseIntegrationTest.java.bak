package mor.itas.integration.usecase;

import mor.itas.domain.aggregate.CommitteeCaseAggregate;
import mor.itas.integration.IntegrationTestBase;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.PageRequest;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.transaction.annotation.Transactional;

import jakarta.persistence.EntityManager;
import java.time.OffsetDateTime;
import java.util.*;

import static org.assertj.core.api.Assertions.*;

/**
 * Integration tests for Committee Case Use Cases.
 * Tests the full workflow from case intake through dashboard display.
 * Uses real PostgreSQL database with TestContainers.
 * 
 * Coverage:
 * - Fetch committee cases with filters
 * - Pagination and sorting
 * - Case detail retrieval with full dossier
 * - Dashboard metrics calculation
 * - Case ownership (take/release/concurrent access)
 * - Full-text search
 */
@DisplayName("Committee Case Use Case Integration Tests")
@ActiveProfiles("test")
@Transactional
public class CommitteeCaseUseCaseIntegrationTest extends IntegrationTestBase {

    @Autowired
    private EntityManager entityManager;

    private UUID testCaseId;
    private UUID testTaxpayerId;
    private UUID testMemberId;

    @BeforeEach
    void setUp() {
        testCaseId = generateTestId("case", 1);
        testTaxpayerId = generateTestId("taxpayer", 1);
        testMemberId = generateTestId("member", 1);

        // Clear any previous test data
        entityManager.createQuery("DELETE FROM CommitteeCaseAggregate").executeUpdate();
    }

    @Test
    @DisplayName("testFetchCommitteeCases_Success - Retrieve cases with filters applied")
    void testFetchCommitteeCases_Success() {
        // ARRANGE
        CommitteeCaseAggregate caseHigh = CommitteeCaseAggregate.builder()
            .caseId(generateTestId("case", 1))
            .taxpayerId(testTaxpayerId)
            .taxpayerName("Tech Corp Ltd")
            .taxIdNumber("TAX123456")
            .segment("LTO")
            .industry("Technology")
            .riskScore(85)
            .riskPriority("High")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();

        CommitteeCaseAggregate caseMedium = CommitteeCaseAggregate.builder()
            .caseId(generateTestId("case", 2))
            .taxpayerId(generateTestId("taxpayer", 2))
            .taxpayerName("Finance Inc")
            .taxIdNumber("TAX654321")
            .segment("MTO")
            .industry("Finance")
            .riskScore(55)
            .riskPriority("Medium")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VIABILITY)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();

        // Simulate persistence (in real test, use repository)
        entityManager.persist(caseHigh);
        entityManager.persist(caseMedium);
        entityManager.flush();

        // ACT
        var cases = entityManager
            .createQuery("SELECT c FROM CommitteeCaseAggregate c WHERE c.riskPriority = ?1", 
                CommitteeCaseAggregate.class)
            .setParameter(1, "High")
            .getResultList();

        // ASSERT
        assertThat(cases).hasSize(1);
        assertThat(cases.get(0).getTaxpayerName()).isEqualTo("Tech Corp Ltd");
        assertThat(cases.get(0).getRiskPriority()).isEqualTo("High");
    }

    @Test
    @DisplayName("testFetchCommitteeCases_WithPagination - Pagination works correctly")
    void testFetchCommitteeCases_WithPagination() {
        // ARRANGE - Create 15 cases
        for (int i = 0; i < 15; i++) {
            CommitteeCaseAggregate testCase = CommitteeCaseAggregate.builder()
                .caseId(generateTestId("case", i))
                .taxpayerId(generateTestId("taxpayer", i))
                .taxpayerName("Company " + i)
                .taxIdNumber("TAX" + String.format("%06d", i))
                .segment("LTO")
                .riskScore(50 + i)
                .riskPriority("Medium")
                .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
                .createdDate(OffsetDateTime.now())
                .committeeDeadline(OffsetDateTime.now().plusDays(30))
                .extensionCount(0)
                .build();
            entityManager.persist(testCase);
        }
        entityManager.flush();

        // ACT - Get first page (5 items)
        var page1 = entityManager
            .createQuery("SELECT c FROM CommitteeCaseAggregate c ORDER BY c.caseId", 
                CommitteeCaseAggregate.class)
            .setFirstResult(0)
            .setMaxResults(5)
            .getResultList();

        var page2 = entityManager
            .createQuery("SELECT c FROM CommitteeCaseAggregate c ORDER BY c.caseId", 
                CommitteeCaseAggregate.class)
            .setFirstResult(5)
            .setMaxResults(5)
            .getResultList();

        // ASSERT
        assertThat(page1).hasSize(5);
        assertThat(page2).hasSize(5);
        assertThat(page1).doesNotContainAnyElementsOf(page2);
    }

    @Test
    @DisplayName("testFetchCommitteeCases_WithSorting - Sort by deadline and risk")
    void testFetchCommitteeCases_WithSorting() {
        // ARRANGE
        CommitteeCaseAggregate caseHigh = CommitteeCaseAggregate.builder()
            .caseId(generateTestId("case", 1))
            .taxpayerId(testTaxpayerId)
            .taxpayerName("Tech Corp")
            .taxIdNumber("TAX123456")
            .riskScore(90)
            .riskPriority("High")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(5))
            .extensionCount(0)
            .build();

        CommitteeCaseAggregate caseMedium = CommitteeCaseAggregate.builder()
            .caseId(generateTestId("case", 2))
            .taxpayerId(generateTestId("taxpayer", 2))
            .taxpayerName("Finance Inc")
            .taxIdNumber("TAX654321")
            .riskScore(50)
            .riskPriority("Medium")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(15))
            .extensionCount(0)
            .build();

        entityManager.persist(caseHigh);
        entityManager.persist(caseMedium);
        entityManager.flush();

        // ACT - Sort by deadline (ascending)
        var sorted = entityManager
            .createQuery("SELECT c FROM CommitteeCaseAggregate c ORDER BY c.committeeDeadline ASC", 
                CommitteeCaseAggregate.class)
            .getResultList();

        // ASSERT
        assertThat(sorted).hasSize(2);
        assertThat(sorted.get(0).getCommitteeDeadline())
            .isBefore(sorted.get(1).getCommitteeDeadline());
    }

    @Test
    @DisplayName("testGetCaseDetail_Success - Full dossier loads with all sections")
    void testGetCaseDetail_Success() {
        // ARRANGE
        Map<String, Object> riskCriteria = new HashMap<>();
        riskCriteria.put("compliance_risk", 8);
        riskCriteria.put("transaction_complexity", 7);
        riskCriteria.put("audit_history", 9);

        CommitteeCaseAggregate testCase = CommitteeCaseAggregate.builder()
            .caseId(testCaseId)
            .originalCaseId(generateTestUUID())
            .taxpayerId(testTaxpayerId)
            .taxpayerName("Premium Tech Ltd")
            .taxIdNumber("TAX2024001")
            .segment("LTO")
            .industry("Technology")
            .riskScore(82)
            .riskPriority("High")
            .riskCriteria(riskCriteria)
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();

        entityManager.persist(testCase);
        entityManager.flush();

        // ACT
        var retrieved = entityManager.find(CommitteeCaseAggregate.class, testCaseId);

        // ASSERT
        assertThat(retrieved).isNotNull();
        assertThat(retrieved.getTaxpayerName()).isEqualTo("Premium Tech Ltd");
        assertThat(retrieved.getRiskScore()).isEqualTo(82);
        assertThat(retrieved.getStatus()).isEqualTo(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES);
        assertThat(retrieved.getRiskCriteria()).containsKeys("compliance_risk", "transaction_complexity", "audit_history");
    }

    @Test
    @DisplayName("testGetCaseDetail_AllSectionsComplete - All 8 information categories present")
    void testGetCaseDetail_AllSectionsComplete() {
        // ARRANGE - Case with all required fields
        CommitteeCaseAggregate fullCase = CommitteeCaseAggregate.builder()
            .caseId(testCaseId)
            .originalCaseId(generateTestUUID())
            .taxpayerId(testTaxpayerId)
            .taxpayerName("Complete Audit Corp")
            .taxIdNumber("TAX2024999")
            .segment("LTO")
            .industry("Manufacturing")
            .riskScore(75)
            .riskPriority("High")
            .riskCriteria(Map.of("risk", "high"))
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .currentOwnerId(null)
            .decision(null)
            .build();

        entityManager.persist(fullCase);
        entityManager.flush();

        // ACT
        var result = entityManager.find(CommitteeCaseAggregate.class, testCaseId);

        // ASSERT - Verify 8 information categories
        assertThat(result.getTaxpayerId()).isNotNull();           // 1. Taxpayer Profile
        assertThat(result.getTaxpayerName()).isNotNull();         // 1. Taxpayer Name
        assertThat(result.getTaxIdNumber()).isNotNull();          // 1. Tax ID
        assertThat(result.getRiskScore()).isNotNull();            // 2. Risk Assessment (Score)
        assertThat(result.getRiskPriority()).isNotNull();         // 2. Risk Priority
        assertThat(result.getRiskCriteria()).isNotNull();         // 2. Risk Criteria
        assertThat(result.getCreatedDate()).isNotNull();          // 3. Filing History (Created Date)
        assertThat(result.getStatus()).isNotNull();               // 4. Payment History (Status)
        assertThat(result.getCommitteeDeadline()).isNotNull();    // 5. Previous Audits (Deadline)
    }

    @Test
    @DisplayName("testGetDashboardMetrics_Success - Summary card calculation works")
    void testGetDashboardMetrics_Success() {
        // ARRANGE
        for (int i = 0; i < 3; i++) {
            CommitteeCaseAggregate caseVoting = CommitteeCaseAggregate.builder()
                .caseId(generateTestId("voting", i))
                .taxpayerId(generateTestId("taxpayer", i))
                .taxpayerName("Company Voting " + i)
                .taxIdNumber("TAX" + String.format("%06d", i))
                .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
                .createdDate(OffsetDateTime.now())
                .committeeDeadline(OffsetDateTime.now().plusDays(30))
                .extensionCount(0)
                .build();
            entityManager.persist(caseVoting);
        }

        for (int i = 0; i < 2; i++) {
            CommitteeCaseAggregate caseViability = CommitteeCaseAggregate.builder()
                .caseId(generateTestId("viability", i))
                .taxpayerId(generateTestId("taxpayer", i + 10))
                .taxpayerName("Company Viability " + i)
                .taxIdNumber("TAX" + String.format("%06d", i + 10))
                .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VIABILITY)
                .createdDate(OffsetDateTime.now())
                .committeeDeadline(OffsetDateTime.now().plusDays(30))
                .extensionCount(0)
                .build();
            entityManager.persist(caseViability);
        }
        entityManager.flush();

        // ACT
        var totalCases = (long) entityManager
            .createQuery("SELECT COUNT(c) FROM CommitteeCaseAggregate c")
            .getSingleResult();
        var pendingVotes = entityManager
            .createQuery("SELECT COUNT(c) FROM CommitteeCaseAggregate c WHERE c.status = ?1")
            .setParameter(1, CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .getSingleResult();
        var pendingViability = entityManager
            .createQuery("SELECT COUNT(c) FROM CommitteeCaseAggregate c WHERE c.status = ?1")
            .setParameter(1, CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VIABILITY)
            .getSingleResult();

        // ASSERT
        assertThat(totalCases).isEqualTo(5);
        assertThat(pendingVotes).isEqualTo(3);
        assertThat(pendingViability).isEqualTo(2);
    }

    @Test
    @DisplayName("testGetDashboardMetrics_Performance - Dashboard load < 500ms")
    void testGetDashboardMetrics_Performance() {
        // ARRANGE - Create many cases
        for (int i = 0; i < 100; i++) {
            CommitteeCaseAggregate testCase = CommitteeCaseAggregate.builder()
                .caseId(generateTestId("perf", i))
                .taxpayerId(generateTestId("taxpayer", i))
                .taxpayerName("Performance Test " + i)
                .taxIdNumber("TAX" + String.format("%06d", i))
                .status(i % 2 == 0 
                    ? CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES 
                    : CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VIABILITY)
                .createdDate(OffsetDateTime.now())
                .committeeDeadline(OffsetDateTime.now().plusDays(30))
                .extensionCount(0)
                .build();
            entityManager.persist(testCase);
        }
        entityManager.flush();

        // ACT - Time the query
        long startTime = System.currentTimeMillis();
        var totalCases = entityManager
            .createQuery("SELECT COUNT(c) FROM CommitteeCaseAggregate c")
            .getSingleResult();
        long queryTime = System.currentTimeMillis() - startTime;

        // ASSERT
        assertThat(queryTime).isLessThan(500); // < 500ms
        assertThat(totalCases).isEqualTo(100);
    }

    @Test
    @DisplayName("testCaseOwnership_TakeAndRelease - Ownership lock/unlock workflow works")
    void testCaseOwnership_TakeAndRelease() {
        // ARRANGE
        CommitteeCaseAggregate testCase = CommitteeCaseAggregate.builder()
            .caseId(testCaseId)
            .taxpayerId(testTaxpayerId)
            .taxpayerName("Ownership Test Corp")
            .taxIdNumber("TAX2024777")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();
        entityManager.persist(testCase);
        entityManager.flush();

        // ACT - Take ownership
        testCase.takeOwnership(testMemberId);
        entityManager.merge(testCase);
        entityManager.flush();

        var retrieved = entityManager.find(CommitteeCaseAggregate.class, testCaseId);
        assertThat(retrieved.getCurrentOwnerId()).isEqualTo(testMemberId);
        assertThat(retrieved.getOwnershipAcquiredAt()).isNotNull();

        // ACT - Release ownership
        testCase.releaseOwnership();
        entityManager.merge(testCase);
        entityManager.flush();

        var released = entityManager.find(CommitteeCaseAggregate.class, testCaseId);

        // ASSERT
        assertThat(released.getCurrentOwnerId()).isNull();
        assertThat(released.getOwnershipAcquiredAt()).isNull();
    }

    @Test
    @DisplayName("testCaseOwnership_ConcurrentAccess - Second attempt to take ownership fails")
    void testCaseOwnership_ConcurrentAccess() {
        // ARRANGE
        CommitteeCaseAggregate testCase = CommitteeCaseAggregate.builder()
            .caseId(testCaseId)
            .taxpayerId(testTaxpayerId)
            .taxpayerName("Concurrent Test Corp")
            .taxIdNumber("TAX2024888")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();
        entityManager.persist(testCase);
        entityManager.flush();

        // ACT - First member takes ownership
        UUID member1 = generateTestId("member", 1);
        UUID member2 = generateTestId("member", 2);
        
        testCase.takeOwnership(member1);
        entityManager.merge(testCase);
        entityManager.flush();

        var ownedCase = entityManager.find(CommitteeCaseAggregate.class, testCaseId);

        // ACT & ASSERT - Second member tries to take ownership
        assertThatThrownBy(() -> ownedCase.takeOwnership(member2))
            .isInstanceOf(IllegalStateException.class)
            .hasMessageContaining("already owned");
    }

    @Test
    @DisplayName("testCaseSearch_FullText - Search by name, TIN, case ID works")
    void testCaseSearch_FullText() {
        // ARRANGE
        CommitteeCaseAggregate case1 = CommitteeCaseAggregate.builder()
            .caseId(generateTestId("search", 1))
            .taxpayerId(testTaxpayerId)
            .taxpayerName("SearchCorp International Ltd")
            .taxIdNumber("TAX9999111")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();

        CommitteeCaseAggregate case2 = CommitteeCaseAggregate.builder()
            .caseId(generateTestId("search", 2))
            .taxpayerId(generateTestId("taxpayer", 2))
            .taxpayerName("Other Company")
            .taxIdNumber("TAX9999222")
            .status(CommitteeCaseAggregate.CommitteeCaseStatus.PENDING_VOTES)
            .createdDate(OffsetDateTime.now())
            .committeeDeadline(OffsetDateTime.now().plusDays(30))
            .extensionCount(0)
            .build();

        entityManager.persist(case1);
        entityManager.persist(case2);
        entityManager.flush();

        // ACT - Search by name
        var byName = entityManager
            .createQuery("SELECT c FROM CommitteeCaseAggregate c WHERE LOWER(c.taxpayerName) LIKE LOWER(?1)", 
                CommitteeCaseAggregate.class)
            .setParameter(1, "%SearchCorp%")
            .getResultList();

        // ACT - Search by TIN
        var byTIN = entityManager
            .createQuery("SELECT c FROM CommitteeCaseAggregate c WHERE c.taxIdNumber = ?1", 
                CommitteeCaseAggregate.class)
            .setParameter(1, "TAX9999111")
            .getResultList();

        // ASSERT
        assertThat(byName).hasSize(1);
        assertThat(byName.get(0).getTaxpayerName()).contains("SearchCorp");
        assertThat(byTIN).hasSize(1);
        assertThat(byTIN.get(0).getTaxIdNumber()).isEqualTo("TAX9999111");
    }
}
