/* ============================================================
   ITAS DESIGN SYSTEM - OKLCH COLOR PALETTE
   ============================================================ */

html {
  color-scheme: dark;
}

/* Override .dark class with ITAS colors */
:root,
html.dark,
body.dark,
.dark {
  --background: oklch(14.8% .004 228.8);
  --foreground: oklch(98.7% .002 197.1);
  --card: oklch(21.8% .008 223.9);
  --card-foreground: oklch(98.7% .002 197.1);
  --popover: oklch(21.8% .008 223.9);
  --popover-foreground: oklch(98.7% .002 197.1);
  --primary: oklch(65% .118 256);
  --primary-foreground: oklch(97% .014 254.604);
  --secondary: oklch(27.4% .006 286.033);
  --secondary-foreground: oklch(98.5% 0 0);
  --muted: oklch(27.5% .011 216.9);
  --muted-foreground: oklch(72.3% .014 214.4);
  --accent: oklch(30% .014 256);
  --accent-foreground: oklch(98.7% .002 197.1);
  --destructive: oklch(65% .19 25);
  --destructive-foreground: oklch(97% .014 254.604);
  --success: oklch(68% .14 152);
  --success-foreground: oklch(14.8% .004 228.8);
  --warning: oklch(80% .15 80);
  --warning-foreground: oklch(24% .04 75);
  --info: oklch(68% .13 240);
  --info-foreground: oklch(14.8% .004 228.8);
  --border: oklch(100% 0 0 / .1);
  --input: oklch(100% 0 0 / .15);
  --ring: oklch(65% .118 256);
  --chart-1: oklch(65% .118 256);
  --chart-2: oklch(68% .13 240);
  --chart-3: oklch(68% .14 152);
  --chart-4: oklch(80% .15 80);
  --chart-5: oklch(68% .15 300);
  --sidebar: oklch(21.8% .008 223.9);
  --sidebar-foreground: oklch(98.7% .002 197.1);
  --sidebar-primary: oklch(65% .118 256);
  --sidebar-primary-foreground: oklch(97% .014 254.604);
  --sidebar-accent: oklch(30% .014 256);
  --sidebar-accent-foreground: oklch(98.7% .002 197.1);
  --sidebar-border: oklch(100% 0 0 / .1);
  --sidebar-ring: oklch(65% .118 256);
}

body {
  background-color: var(--background);
  color: var(--foreground);
  -webkit-font-smoothing: antialiased;
  font-size: .875rem;
  line-height: 1.45;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
* { margin:0; padding:0; box-sizing:border-box; }
html, body { width:100%; height:100%; margin:0; padding:0; }

/* ============================================================
   SIDEBAR
   ============================================================ */
.sidebar { 
  width:240px; 
  background: var(--background); 
  color: var(--foreground); 
  padding:20px 0; 
  display:flex; 
  flex-direction:column; 
  flex-shrink:0; 
  border-right:1px solid var(--border); 
}

.sidebar .logo { 
  padding:0 24px 20px; 
  font-size:20px; 
  font-weight:600; 
  border-bottom:1px solid var(--border); 
}

.sidebar .logo span { 
  color: var(--primary); 
}

.sidebar nav { flex:1; padding:20px 0; }

.sidebar nav a { 
  display:flex; 
  align-items:center; 
  padding:12px 24px; 
  color: var(--muted-foreground); 
  text-decoration:none; 
  transition:0.2s; 
  font-size:14px; 
  border-left:3px solid transparent; 
  cursor:pointer; 
}

.sidebar nav a i { 
  width:24px; 
  margin-right:12px; 
  color: var(--primary); 
}

.sidebar nav a:hover, .sidebar nav a.active { 
  background: var(--card); 
  color: var(--primary); 
  border-left-color: var(--primary); 
}

.sidebar .footer { 
  padding:20px 24px; 
  font-size:12px; 
  color: var(--muted-foreground); 
  border-top:1px solid var(--border); 
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */
.main { 
  flex:1; 
  padding:24px 32px; 
  overflow-y:auto; 
  background: var(--background); 
  width:100%; 
  height:100vh; 
  display:flex; 
  flex-direction:column; 
}

.top-bar { 
  display:flex; 
  justify-content:space-between; 
  align-items:center; 
  margin-bottom:24px; 
  flex-wrap:wrap; 
}

.top-bar h1 { 
  font-size:26px; 
  font-weight:600; 
  color: var(--primary); 
}

.role-selector { 
  display:flex; 
  align-items:center; 
  gap:12px; 
  background: var(--card); 
  padding:6px 16px 6px 20px; 
  border-radius:30px; 
  border:1px solid var(--border); 
}

.role-selector label { 
  font-weight:500; 
  color: var(--muted-foreground); 
  font-size:14px; 
}

.role-selector select { 
  padding:6px 12px; 
  border:1px solid var(--border); 
  border-radius:20px; 
  background: var(--input); 
  color: var(--foreground); 
  font-weight:500; 
  font-size:14px; 
  cursor:pointer; 
  outline:none; 
}

.role-selector .avatar { 
  width:36px; 
  height:36px; 
  border-radius:50%; 
  background: var(--primary); 
  display:flex; 
  align-items:center; 
  justify-content:center; 
  color: var(--primary-foreground); 
  font-weight:600; 
  font-size:14px; 
}

/* Cards Grid */
.cards { 
  display:grid; 
  grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); 
  gap:16px; 
  margin-bottom:24px; 
}

.card { 
  background: var(--card); 
  padding:16px 20px; 
  border-radius:12px; 
  border:1px solid var(--border); 
  display:flex; 
  justify-content:space-between; 
  align-items:center; 
  transition:0.3s ease;
}

.card:hover {
  border-color: var(--primary);
  box-shadow: 0 4px 12px var(--ring);
}

.card .info h3 { 
  font-size:13px; 
  font-weight:500; 
  color: var(--muted-foreground); 
  margin-bottom:4px; 
}

.card .info .number { 
  font-size:24px; 
  font-weight:700; 
  color: var(--primary); 
}

.card .icon { 
  font-size:24px; 
  color: var(--primary); 
  opacity:0.6; 
}

/* Section Titles */
.section-title { 
  font-size:18px; 
  font-weight:600; 
  margin-bottom:16px; 
  color: var(--foreground); 
  border-bottom: 2px solid var(--primary);
  padding-bottom: 8px;
}

/* Tables */
.table-container { 
  background: var(--card); 
  border-radius:12px; 
  border:1px solid var(--border); 
  overflow-x:auto; 
  margin-bottom:24px; 
}

table { 
  width:100%; 
  border-collapse:collapse; 
  font-size:14px; 
}

th { 
  background: var(--input); 
  text-align:left; 
  padding:12px 16px; 
  font-weight:600; 
  border-bottom:1px solid var(--border); 
  color: var(--primary); 
}

td { 
  padding:10px 16px; 
  border-bottom:1px solid var(--border); 
  vertical-align:middle; 
  color: var(--foreground); 
}

/* Badges */
.badge { 
  display:inline-block; 
  padding:3px 10px; 
  border-radius:20px; 
  font-size:12px; 
  font-weight:600; 
}

.badge.draft { background: var(--card); color: var(--muted-foreground); }
.badge.submitted { background: rgba(255, 201, 77, 0.15); color: var(--warning); }
.badge.director-approved { background: rgba(82, 199, 122, 0.15); color: var(--success); }
.badge.feedback { background: rgba(74, 143, 217, 0.15); color: var(--primary); }
.badge.feedback-collected { background: rgba(82, 199, 122, 0.15); color: var(--success); }
.badge.senior-pending { background: rgba(255, 201, 77, 0.15); color: var(--warning); }
.badge.senior-approved { background: rgba(82, 199, 122, 0.15); color: var(--success); }
.badge.cascaded { background: rgba(82, 199, 122, 0.15); color: var(--success); }
.badge.rejected { background: rgba(255, 82, 82, 0.15); color: var(--destructive); }
.badge.assigned { background: rgba(74, 143, 217, 0.15); color: var(--primary); }
.badge.pending { background: rgba(255, 201, 77, 0.15); color: var(--warning); }
.badge.selected { background: rgba(74, 143, 217, 0.15); color: var(--primary); }
.badge.created { background: var(--card); color: var(--muted-foreground); }

/* Buttons */
.btn { 
  padding:5px 12px; 
  border:none; 
  border-radius:6px; 
  cursor:pointer; 
  font-weight:500; 
  font-size:12px; 
  transition:0.2s; 
  display:inline-flex; 
  align-items:center; 
  gap:5px; 
}

.btn-primary { 
  background: var(--primary); 
  color: var(--primary-foreground); 
}

.btn-primary:hover { 
  opacity: 0.9;
}

.btn-success { 
  background: var(--success); 
  color: var(--success-foreground); 
}

.btn-success:hover { 
  opacity: 0.9;
}

.btn-warning { 
  background: var(--warning); 
  color: var(--warning-foreground); 
}

.btn-warning:hover { 
  opacity: 0.9;
}

.btn-danger { 
  background: var(--destructive); 
  color: var(--destructive-foreground); 
}

.btn-danger:hover { 
  opacity: 0.9;
}

.btn-outline { 
  background:transparent; 
  border:1px solid var(--primary); 
  color: var(--primary); 
}

.btn-outline:hover { 
  background: var(--primary); 
  color: var(--primary-foreground); 
}

.btn-info { 
  background: var(--info); 
  color: var(--info-foreground); 
}

.btn-info:hover { 
  opacity: 0.9;
}

.btn-purple { 
  background: var(--primary); 
  color: var(--primary-foreground); 
}

.btn-purple:hover { 
  opacity: 0.9;
}

.btn-sm { 
  padding:3px 8px; 
  font-size:11px; 
}

/* Action Bar */
.action-bar { 
  display:flex; 
  justify-content:space-between; 
  align-items:center; 
  margin-bottom:16px; 
  flex-wrap:wrap; 
  gap:12px; 
}

.action-bar .filters { 
  display:flex; 
  gap:12px; 
  flex-wrap:wrap; 
}

.action-bar .filters select, 
.action-bar .filters input { 
  padding:6px 12px; 
  border:1px solid var(--border); 
  border-radius:6px; 
  font-size:13px; 
  background: var(--input); 
  color: var(--foreground); 
}

/* Modals */
.modal-overlay { 
  display:none; 
  position:fixed; 
  top:0; 
  left:0; 
  right:0; 
  bottom:0; 
  background:rgba(0,0,0,0.8); 
  z-index:1000; 
  justify-content:center; 
  align-items:center; 
}

.modal-overlay.show { 
  display:flex; 
}

.modal { 
  background: var(--card); 
  border-radius:16px; 
  max-width:740px; 
  width:92%; 
  max-height:92vh; 
  overflow-y:auto; 
  padding:24px 28px; 
  border:1px solid var(--border); 
  box-shadow:0 10px 40px rgba(0,0,0,0.5); 
  animation:fadeIn 0.2s; 
}

@keyframes fadeIn { 
  from { opacity:0; transform:scale(0.96); } 
  to { opacity:1; transform:scale(1); } 
}

.modal h2 { 
  margin-bottom:16px; 
  font-size:22px; 
  color: var(--primary); 
}

.form-group { 
  margin-bottom:14px; 
}

.form-group label { 
  display:block; 
  font-weight:500; 
  margin-bottom:4px; 
  font-size:14px; 
  color: var(--foreground); 
}

.form-group input, 
.form-group select, 
.form-group textarea { 
  width:100%; 
  padding:8px 12px; 
  border:1px solid var(--border); 
  border-radius:6px; 
  font-size:14px; 
  background: var(--input); 
  color: var(--foreground); 
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--primary);
  outline: none;
  box-shadow: 0 0 0 3px rgba(74, 143, 217, 0.1);
}

.form-group textarea { 
  min-height:80px; 
  resize:vertical; 
}

.modal .actions { 
  display:flex; 
  justify-content:flex-end; 
  gap:12px; 
  margin-top:20px; 
}

.modal .checkbox-group { 
  display:grid; 
  grid-template-columns:1fr 1fr 1fr; 
  gap:6px; 
}

.modal .checkbox-group label { 
  display:flex; 
  align-items:center; 
  gap:6px; 
  font-size:14px; 
  color: var(--foreground); 
}

/* Layout */
.role-view { display:none; }
.role-view.active { display:block; }
.hidden { display:none !important; }

/* Grid & Layout */
.region-grid { 
  display:grid; 
  grid-template-columns:1fr 1fr 1fr 1fr 1fr 1fr; 
  gap:4px; 
  font-size:13px; 
}

.region-grid input { 
  padding:4px 6px; 
  border:1px solid var(--border); 
  border-radius:4px; 
  background: var(--input); 
  color: var(--foreground); 
}

.detail-table { 
  width:100%; 
  border-collapse:collapse; 
  font-size:13px; 
}

.detail-table th, 
.detail-table td { 
  padding:5px 10px; 
  border:1px solid var(--border); 
  text-align:left; 
  color: var(--foreground); 
}

.detail-table th { 
  background: var(--input); 
  color: var(--primary); 
}

/* Status Timeline */
.status-timeline { 
  display:flex; 
  flex-wrap:wrap; 
  gap:8px; 
  margin:12px 0; 
  padding:12px; 
  background: var(--input); 
  border-radius:8px; 
  border:1px solid var(--border); 
}

.status-timeline .step { 
  display:flex; 
  align-items:center; 
  gap:6px; 
  font-size:13px; 
  color: var(--foreground); 
}

.status-timeline .step .dot { 
  width:10px; 
  height:10px; 
  border-radius:50%; 
  display:inline-block; 
  background: var(--primary); 
}

.status-timeline .step .dot.done { 
  background: var(--success); 
}

.status-timeline .step .dot.active { 
  background: var(--warning); 
  animation:pulse 1.5s infinite; 
}

.status-timeline .step .dot.pending { 
  background: var(--muted-foreground); 
}

@keyframes pulse { 
  0%,100% { transform:scale(1); } 
  50% { transform:scale(1.3); } 
}

.date-range { 
  display:grid; 
  grid-template-columns:1fr 1fr; 
  gap:12px; 
}

/* Responsive */
@media (max-width:768px) {
  .sidebar { width:60px; }
  .sidebar .logo, .sidebar nav a span, .sidebar .footer { display:none; }
  .sidebar nav a { justify-content:center; padding:12px 0; }
  .sidebar nav a i { margin-right:0; }
  .main { padding:16px; }
  .cards { grid-template-columns:1fr 1fr; }
  .date-range { grid-template-columns:1fr; }
  .region-grid { grid-template-columns:1fr 1fr 1fr; }
}

/* ============================================================
   SIDEBAR
   ============================================================ */
