}

.btn-primary:hover { 
  background: var(--itas-primary-light); 
}

.btn-success { 
  background: var(--itas-success); 
  color:#fff; 
}

.btn-success:hover { 
  background: #42b86a; 
}

.btn-warning { 
  background: var(--itas-warning); 
  color:#000; 
}

.btn-warning:hover { 
  background: #ffb830; 
}

.btn-danger { 
  background: var(--itas-destructive); 
  color:#fff; 
}

.btn-danger:hover { 
  background: #ff3d3d; 
}

.btn-outline { 
  background:transparent; 
  border:1px solid var(--itas-primary); 
  color: var(--itas-primary); 
}

.btn-outline:hover { 
  background: var(--itas-primary); 
  color:#fff; 
}

.btn-info { 
  background: var(--itas-primary); 
  color:#fff; 
}

.btn-info:hover { 
  background: var(--itas-primary-light); 
}

.btn-purple { 
  background: var(--itas-primary); 
  color:#fff; 
}

.btn-purple:hover { 
  background: var(--itas-primary-light); 
}

.btn-sm { 
