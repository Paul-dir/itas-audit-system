.action-bar .filters select, 
.action-bar .filters input { 
  padding:6px 12px; 
  border:1px solid var(--itas-border); 
  border-radius:6px; 
  font-size:13px; 
  background: var(--itas-input); 
  color: var(--itas-foreground); 
}

/* Modals */
.modal-overlay { 
  display:none; 
  position:fixed; 
  top:0; 
  left:0; 
  right:0; 
  bottom:0; 
  background:rgba(0,0,0,0.8); 
  z-index:1000; 
  justify-content:center; 
  align-items:center; 
}

.modal-overlay.show { 
  display:flex; 
}

.modal { 
  background: var(--itas-card); 
  border-radius:16px; 
  max-width:740px; 
  width:92%; 
  max-height:92vh; 
  overflow-y:auto; 
  padding:24px 28px; 
  border:1px solid var(--itas-border); 
  box-shadow:0 10px 40px rgba(0,0,0,0.5); 
  animation:fadeIn 0.2s; 
}

@keyframes fadeIn { 
  from { opacity:0; transform:scale(0.96); } 
  to { opacity:1; transform:scale(1); } 
}

.modal h2 { 
  margin-bottom:16px; 
  font-size:22px; 
  color: var(--itas-primary); 
}

.form-group { 
  margin-bottom:14px; 
}

.form-group label { 
  display:block; 
  font-weight:500; 
  margin-bottom:4px; 
  font-size:14px; 
  color: var(--itas-foreground); 
}

.form-group input, 
.form-group select, 
.form-group textarea { 
  width:100%; 
  padding:8px 12px; 
  border:1px solid var(--itas-border); 
  border-radius:6px; 
  font-size:14px; 
  background: var(--itas-input); 
  color: var(--itas-foreground); 
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--itas-primary);
  outline: none;
  box-shadow: 0 0 0 3px rgba(74, 143, 217, 0.1);
}

.form-group textarea { 
  min-height:80px; 
  resize:vertical; 
}

.modal .actions { 
  display:flex; 
  justify-content:flex-end; 
  gap:12px; 
  margin-top:20px; 
}

.modal .checkbox-group { 
  display:grid; 
  grid-template-columns:1fr 1fr 1fr; 
  gap:6px; 
}

.modal .checkbox-group label { 
  display:flex; 
  align-items:center; 
  gap:6px; 
  font-size:14px; 
  color: var(--itas-foreground); 
}

/* Layout */
.role-view { display:none; }
.role-view.active { display:block; }
.hidden { display:none !important; }

/* Grid & Layout */
.region-grid { 
  display:grid; 
  grid-template-columns:1fr 1fr 1fr 1fr 1fr 1fr; 
  gap:4px; 
  font-size:13px; 
}

.region-grid input { 
  padding:4px 6px; 
  border:1px solid var(--itas-border); 
  border-radius:4px; 
  background: var(--itas-input); 
  color: var(--itas-foreground); 
}

.detail-table { 
  width:100%; 
  border-collapse:collapse; 
  font-size:13px; 
}

.detail-table th, 
.detail-table td { 
  padding:5px 10px; 
  border:1px solid var(--itas-border); 
  text-align:left; 
  color: var(--itas-foreground); 
}

.detail-table th { 
  background: var(--itas-input); 
  color: var(--itas-primary); 
}

/* Status Timeline */
.status-timeline { 
  display:flex; 
  flex-wrap:wrap; 
  gap:8px; 
  margin:12px 0; 
  padding:12px; 
  background: var(--itas-input); 
  border-radius:8px; 
  border:1px solid var(--itas-border); 
}

.status-timeline .step { 
  display:flex; 
  align-items:center; 
  gap:6px; 
  font-size:13px; 
  color: var(--itas-foreground); 
}

.status-timeline .step .dot { 
  width:10px; 
  height:10px; 
  border-radius:50%; 
  display:inline-block; 
  background: var(--itas-primary); 
}

.status-timeline .step .dot.done { 
  background: var(--itas-success); 
}

.status-timeline .step .dot.active { 
  background: var(--itas-warning); 
  animation:pulse 1.5s infinite; 
}

.status-timeline .step .dot.pending { 
  background: var(--itas-muted); 
}

@keyframes pulse { 
  0%,100% { transform:scale(1); } 
  50% { transform:scale(1.3); } 
}

.date-range { 
  display:grid; 
  grid-template-columns:1fr 1fr; 
  gap:12px; 
}

/* Responsive */
@media (max-width:768px) {
  .sidebar { width:60px; }
  .sidebar .logo, .sidebar nav a span, .sidebar .footer { display:none; }
  .sidebar nav a { justify-content:center; padding:12px 0; }
  .sidebar nav a i { margin-right:0; }
  .main { padding:16px; }
  .cards { grid-template-columns:1fr 1fr; }
  .date-range { grid-template-columns:1fr; }
  .region-grid { grid-template-columns:1fr 1fr 1fr; }
}
